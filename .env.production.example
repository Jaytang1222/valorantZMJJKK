NODE_ENV=production

# Database credentials are consumed by docker-compose.production.yml.
POSTGRES_DB=valo_yiba
POSTGRES_USER=valo
POSTGRES_PASSWORD=replace-with-a-long-random-password

# API secrets. Keep these outside Git and preserve them across redeploys.
PASSWORD_PEPPER=replace-with-at-least-32-random-characters
INTERNAL_API_SECRET=replace-with-a-different-at-least-32-random-characters
RATE_LIMIT_PROXY_SECRET=replace-with-a-separate-at-least-32-random-characters
USER_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# The browser reaches the API through the Nginx public address.
CORS_ORIGIN=http://your-public-host
NEXT_PUBLIC_WS_URL=http://your-public-host

# Optional Sentry values.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN=
